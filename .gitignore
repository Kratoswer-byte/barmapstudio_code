!extracted/{app}/join-game.bat
!extracted/{app}/play-last-map.bat
!extracted/{app}/README-FIRST.txt
!extracted/{app}/feedback.properties
!extracted/{app}/update.properties
!extracted/{app}/donation.properties
!extracted/{app}/donation_qrcode.png
